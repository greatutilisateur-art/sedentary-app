{
  "policy_version": "decision-policy-v1.0.0",
  "selector_version": "weighted-selector-v1.0.0",
  "default_slots": ["10:10", "11:50", "15:10", "17:30"],
  "technical_lateness_tolerance_minutes": 15,
  "spacing": {
    "standard_min_minutes": 90,
    "boundary_exception_min_minutes": 60,
    "boundaries": ["lunch_start", "work_end"],
    "cancel_if_below_exception_min": true,
    "catch_up_cancelled_slots": false
  },
  "snooze": {
    "options_minutes": [10, 30],
    "one_active_opportunity": true,
    "priority_over_normal_slot": true,
    "cancel_if_crosses_lunch_or_work_end": true
  },
  "start_of_day": {
    "supported": true,
    "enabled_by_default": false,
    "counts_for_spacing": true,
    "included_in_default_four_slots": false
  },
  "scoring": {
    "min_weight": 0.05,
    "max_weight": 20.0,
    "history_window_proposals": 4,
    "repetition_coefficients": {
      "same_as_previous_activity": 0.15,
      "same_as_previous_family": 0.45,
      "same_activity_in_recent_window": 0.55,
      "family_at_least_twice_in_recent_window": 0.75,
      "no_repetition": 1.0
    },
    "combine_repetition_coefficients": false,
    "use_evidence_level_at_runtime": false,
    "use_preference_bonus_in_v0": false
  },
  "alternative": {
    "exclude_all_activities_seen_in_interaction": true,
    "persistent_penalty": false,
    "stop_when_exhausted": true
  },
  "history": {
    "engine_scope": "current_day_and_recent_proposals",
    "persist_full_trace_in_release_build": false,
    "persist_full_trace_in_debug_build": true
  }
}
