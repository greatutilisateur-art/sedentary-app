{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sedentaryapp.local/schema/activity_catalog_schema_v1.json",
  "title": "SedentaryApp Activity Catalog V1",
  "description": "Contrat de données du catalogue d'activités V0.",
  "type": "object",
  "required": [
    "catalog_version",
    "policy_compatibility",
    "vocabulary_version",
    "status",
    "activity_count",
    "activities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "policy_compatibility": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.(x|[0-9]+)$"
    },
    "vocabulary_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "deprecated",
        "archived"
      ]
    },
    "activity_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "status",
        "title",
        "instruction",
        "user_category",
        "internal_family",
        "intensity",
        "duration_seconds_min",
        "duration_seconds_max",
        "compatible_postures",
        "preferred_posture",
        "standing_required",
        "walking_required",
        "eligible_opportunity_types",
        "sedentary_break_effect",
        "space_required",
        "discretion",
        "body_focus",
        "safety_flags",
        "evidence_level",
        "base_weight",
        "variant_of",
        "search_synonyms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+[0-9]{2}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "deprecated",
            "archived"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "instruction": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        },
        "user_category": {
          "enum": [
            "mouvement",
            "mobilite",
            "etirement",
            "dynamique",
            "bien_etre",
            "visuel"
          ]
        },
        "internal_family": {
          "enum": [
            "ankle_mobility",
            "brisk_walk",
            "calf_raise",
            "calf_stretch",
            "chest_opening",
            "distance_gaze",
            "global_reach",
            "hamstring_stretch",
            "hip_mobility",
            "outdoor_walk",
            "posterior_chain_mobility",
            "shoulder_mobility",
            "shoulder_release",
            "sit_to_stand",
            "slow_breathing",
            "squat",
            "stairs",
            "start_lower_body",
            "start_upper_body",
            "thoracic_rotation",
            "visual_rest",
            "walking",
            "walking_hydration_anchor"
          ]
        },
        "intensity": {
          "enum": [
            "gentle",
            "active",
            "dynamic"
          ]
        },
        "duration_seconds_min": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "duration_seconds_max": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "compatible_postures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "seated",
              "standing"
            ]
          }
        },
        "preferred_posture": {
          "anyOf": [
            {
              "enum": [
                "seated",
                "standing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "standing_required": {
          "type": "boolean"
        },
        "walking_required": {
          "type": "boolean"
        },
        "eligible_opportunity_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "standard",
              "start_of_day"
            ]
          }
        },
        "sedentary_break_effect": {
          "enum": [
            "certain",
            "probable",
            "optional",
            "adjacent_only"
          ]
        },
        "space_required": {
          "enum": [
            "desk",
            "small",
            "outside_desk",
            "building",
            "outside"
          ]
        },
        "discretion": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "body_focus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ankles",
              "back",
              "breathing",
              "calves",
              "cardiorespiratory",
              "chest",
              "glutes",
              "hamstrings",
              "hips",
              "legs",
              "pelvis",
              "posterior_chain",
              "shoulders",
              "thoracic_spine",
              "trunk",
              "upper_back",
              "visual",
              "whole_body"
            ]
          }
        },
        "safety_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "avoid_if_balance_issue",
              "no_forced_range",
              "return_to_normal_breathing_if_uncomfortable",
              "soft_knees_allowed",
              "stable_chair",
              "stable_footing",
              "stop_if_dizziness",
              "stop_if_pain",
              "stop_if_unwell",
              "use_support_if_needed"
            ]
          }
        },
        "evidence_level": {
          "enum": [
            "high",
            "moderate",
            "limited",
            "indirect"
          ]
        },
        "base_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "variant_of": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]+[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "search_synonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
